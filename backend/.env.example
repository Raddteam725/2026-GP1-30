# Process configuration example; the backend does not automatically load this file.
# Supply credentials using the existing secure ADC setup outside the repository.
FIREBASE_PROJECT_ID=radd-32eb6
FIREBASE_STORAGE_BUCKET=radd-32eb6.firebasestorage.app

# Off by default. Set on explicitly to embed registration/replacement photographs
# and enable AI candidates. Model/dependency failure then rejects photo saves (503).
RADD_FACE_MATCHING=off
RADD_MATCH_THRESHOLD=0.596
RADD_MATCH_TOP_K=5

# Backfill is a separate manual command; enabling matching never runs it.
# Keep maintenance off unless separately authorized for the target data.
RADD_LOCAL_JOBS=0
