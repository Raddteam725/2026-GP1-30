rules_version = '2';

// Radd: clients NEVER access Firestore directly. Every read and write goes
// through the FastAPI backend, which authenticates the Firebase ID token,
// enforces role/ownership and uses the Admin SDK (which is not subject to
// these rules). So the client-facing database is closed completely -- there
// is no legitimate client request to allow. Never switch this back to a
// time-limited "test mode" rule: that exposes every Guardian, individual,
// case and found-report record to anyone holding the public API key.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
