<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own system splash (background + centred launcher
         icon) before Flutter's first frame. Radd's branded start is the Flutter
         splash ANIMATION, so that system splash is kept to the animation's own
         clean background with no icon: the launch feels like one continuous
         splash, not a static logo followed by an animated one. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#F9FBFD</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_icon_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#F9FBFD</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
